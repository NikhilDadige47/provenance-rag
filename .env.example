# ==============================================================================
# PROVENANCE RAG: OWNER CONFIGURATION (.env)
# Only owner-funded service keys and server settings belong here.
# Visitor keys (LlamaParse, visitor LLM) are supplied at runtime and NEVER put here.
# ==============================================================================

# Environment
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Cohere (Owner Key for Embeddings and Reranking)
# Hard budget MUST be set in Cohere dashboard before production deployment.
COHERE_API_KEY=co_placeholder_owner_key_here
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_RERANK_MODEL=rerank-english-v3.0
EMBEDDING_VERSION=emb-v1

# Qdrant Vector DB (Owner Instance)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=provenance_rag_v1

# Default Owner LLM (Used for Tier A demo & Tier B uploads)
# Keep tightly capped!
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_API_KEY=gsk_placeholder_owner_key_here
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Langfuse Tracing (Optional - Privacy Safe)
# Note: Visitor uploads only record metadata, no raw text or keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# Cost & Spend Controls (Owner Protection)
# ------------------------------------------------------------------------------
KILL_SWITCH_ACTIVE=false
KILL_SWITCH_DISABLE_UPLOADS=false
KILL_SWITCH_DISABLE_OWNER_LLM=false

# Per-Session Caps
SESSION_MAX_CHUNKS_EMBEDDED=1500
SESSION_MAX_RERANK_CALLS=30
SESSION_MAX_QUESTIONS_OWNER_LLM=15
SESSION_MAX_QUESTIONS_OWN_LLM=100
SESSION_MAX_DOCUMENTS=3
SESSION_MAX_TOTAL_PAGES=30
SESSION_TTL_HOURS=2

# Daily Global Caps
DAILY_MAX_CHUNKS_EMBEDDED=25000
DAILY_MAX_RERANK_CALLS=500
DAILY_MAX_OWNER_LLM_TOKENS=500000
DAILY_MAX_JOBS=100
